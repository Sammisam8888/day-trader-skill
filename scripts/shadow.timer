# Runs the shadow scan every weekday morning, just after the opening range.
# Install:
#   sudo cp scripts/shadow.{timer,service} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now shadow.timer
[Unit]
Description=Shadow trading scan, weekdays after the opening range

[Timer]
OnCalendar=Mon-Fri *-*-* 09:31:00 Asia/Kolkata
Persistent=false

[Install]
WantedBy=timers.target
