[Unit]
Description=Backup flatten (the fill monitor flattens at the flat-by time)

[Timer]
# Normal days flatten at 15:05 from the fill monitor; Muhurat at 15:10.
# These are the backup passes. With nothing open the flatten does nothing.
OnCalendar=*-*-* 15:08:00 Asia/Kolkata
OnCalendar=*-*-* 15:14:00 Asia/Kolkata
Persistent=false

[Install]
WantedBy=timers.target
