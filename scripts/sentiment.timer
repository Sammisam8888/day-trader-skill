[Unit]
Description=Market sentiment refresh: 08:45 pre-open, then every 15 minutes in session

[Timer]
# Positioning every 15 minutes; the news read refreshes at most every 30.
# Returns at once on a non-trading day.
OnCalendar=*-*-* 08:45:00 Asia/Kolkata
OnCalendar=*-*-* 09..15:02/15:00 Asia/Kolkata
Persistent=false

[Install]
WantedBy=timers.target
