[Unit]
Description=Breakout scanner, every 5 minutes through the session

[Timer]
# Every day, 09:00-15:55 in 5-minute steps. The scanner returns at once on a
# non-trading day or outside the entry window, so weekends cost nothing and
# special sessions (Muhurat, on a Sunday) are covered without an edit.
# Validated with `systemd-analyze calendar`.
OnCalendar=*-*-* 09..15:00/5:00 Asia/Kolkata
Persistent=false

[Install]
WantedBy=timers.target
