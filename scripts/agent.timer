[Unit]
Description=The AI agent's decisions: 09:35, then every 15 minutes to 14:20, weekdays

[Timer]
OnCalendar=Mon..Fri *-*-* 09:35,50:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 10,11,12,13:05,20,35,50:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 14:05,20:00 Asia/Kolkata
Persistent=false

[Install]
WantedBy=timers.target
